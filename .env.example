# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed - it holds live credentials.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Security --------------------------------------------------------------
# Required in production; the app refuses to start without it there. In
# development a temporary key is generated per process (so sessions reset on
# restart). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ENVIRONMENT=development
# How long a login lasts. 480 = 8 hours; short values log people out mid-task.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Database --------------------------------------------------------------
DATABASE_URL=sqlite:///./nutrition_app.db

# --- Groq (required - the AI features do not work without at least one key) --
# Free keys: https://console.groq.com/keys
#
# Rate limits are per ORGANISATION, so extra keys only add capacity if they
# belong to genuinely different accounts. Two keys on one account share a
# single daily quota. Keys are tried in order and rotated automatically when
# one hits its limit. GROQ_API_KEY_2 .. _10 are all picked up.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Two model tiers - see the "Model selection" comment in
# app/config/groq_config.py for which of the six AI agents uses which and why.
# Groq retires models without much notice - if either starts returning
# "model_not_found", check GET https://api.groq.com/openai/v1/models for
# what's currently active rather than guessing a replacement.
#
# FAST: high-frequency / low-reasoning work (nutrition estimates, free-form
# recipes). REASONING: multi-constraint numeric planning, strict JSON
# schemas, and the chat orchestrator's tool selection - it must support
# tool calling reliably, which the fast model does not (verified with
# scripts/diagnose_groq.py before picking one).
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b

# GROQ_MODEL / GROQ_ORCHESTRATOR_MODEL still work as fallbacks for the two
# above, kept for any existing deployment that already sets them - prefer the
# names above for anything new.
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_ORCHESTRATOR_MODEL=openai/gpt-oss-120b

# --- Email (optional) ------------------------------------------------------
# Used to send plans as PDF attachments and password-reset links. If unset,
# the Email button simply does not appear and everything else works normally.
#
# Sent over Brevo's HTTPS API rather than raw SMTP - most hosts (Render
# included) block outbound SMTP ports to stop the platform being used as a
# spam relay, so an smtplib connection never reaches Gmail's servers from
# there. Brevo is free (no card) at https://www.brevo.com: verify EMAIL_USER
# as a sender under Settings -> Senders, then create a key under
# Settings -> SMTP & API -> API Keys.
BREVO_API_KEY=
EMAIL_USER=
EMAIL_FROM_NAME=NutriPlan
# Users can email plans to any address, so this caps sends per user per hour.
EMAIL_RATE_LIMIT_PER_HOUR=10

# --- Nutrition data sources ------------------------------------------------
# Open Food Facts needs no key and is used automatically for packaged and
# branded foods (label data, per 100g).
#
# USDA FoodData Central covers generic whole foods - "chicken breast", "brown
# rice" - with laboratory-measured values. The key is free and takes a minute:
#   https://fdc.nal.usda.gov/api-key-signup.html
# Without it the app still works; generic foods just fall back to an AI
# estimate, which is labelled as an estimate in the UI.
USDA_API_KEY=

# --- Optional integrations -------------------------------------------------
# Only needed if you re-enable web-search tools on the agents.
EXA_API_KEY=
FIRECRAWL_API_KEY=

# --- Dataset loading (optional) --------------------------------------------
MFP_DATASET_PATH=./mfp-diaries.tsv
USE_MFP_DATASET=false
MAX_RECORDS_TO_LOAD=1000
REPLACE_EXISTING_DATA=true
